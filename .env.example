# ─── Frontend (bundled into the browser — NEVER put secrets here) ───
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DOKU_CLIENT_ID=
VITE_DOKU_IS_PRODUCTION=false

# ─── Backend only (Vercel Functions / Edge — never exposed to browser) ───
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PUBLIC_KEY=
DOKU_IS_PRODUCTION=false

# Must match, byte-for-byte, the HTTP Notification path registered in the Doku dashboard.
DOKU_NOTIFICATION_PATH=/api/doku-webhook
# Comma-separated Doku channels proven to work via non-SNAP Checkout API. Empty = all channels.
DOKU_ENABLED_METHODS=
# Comma-separated tester emails (server-only). Empty = whitelist disabled (open to all).
BETA_ALLOWED_EMAILS=
# Service fee in IDR added to every order. Defaults to 2500 if unset.
SERVICE_FEE=2500
# Static QRIS payload (Toko Fira) used by the QRIS converter. Server-only — never prefix with VITE_.
QRIS_STATIC_PAYLOAD=
