# ─── Frontend (bundled into the browser — NEVER put secrets here) ───
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Soft-launch gate for the /store payment UI. Keep in sync with the server-side
# PAYMENTS_LIVE / PREVIEW_EMAILS below (the VITE_ pair only gates the browser).
# Leave unset while hidden: only VITE_PREVIEW_EMAILS (logged in via OTP) see checkout.
# Set VITE_PAYMENTS_LIVE=true at launch to open payments to everyone.
VITE_PAYMENTS_LIVE=false
VITE_PREVIEW_EMAILS=

# Online (iPaymu) checkout button: 'disabled' | 'live'. Keep in sync with the
# server-side IPAYMU_MODE. Empty = disabled.
VITE_IPAYMU_MODE=disabled

# Optional override for the manual BCA bank info shown on /bayar-manual.
VITE_MANUAL_BANK_INFO=

# ─── Backend only (Vercel Functions — never exposed to browser) ───
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side twin of the VITE_ soft-launch gate. Keep byte-for-byte in sync.
PAYMENTS_LIVE=false
PREVIEW_EMAILS=

# Comma-separated tester emails (server-only). Empty = whitelist disabled (open to all).
BETA_ALLOWED_EMAILS=
# Service fee in IDR added to every online order. Defaults to 2500 if unset.
SERVICE_FEE=2500

# ─── iPaymu gateway (server-only) ───
# Master kill switch: 'disabled' | 'live'. Empty = disabled. Do NOT set 'live'
# until a real (non-sandbox) transaction has been confirmed.
IPAYMU_MODE=disabled
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_IS_PRODUCTION=false
# Absolute public URL. Without it, notifyUrl falls back to req.headers.host and
# preview deploys send iPaymu callbacks to the wrong place.
PUBLIC_BASE_URL=https://www.lingchineselab.com

# ─── Manual payment + admin verification (server-only) ───
# Comma-separated admin emails. FAIL CLOSED: empty = nobody is admin.
# Real values live only in .env.local / the Vercel dashboard — never commit them.
ADMIN_EMAILS=

# ─── QRIS scan payment (unique-nominal, Livin' Merchant) ───
# Full decoded static QR payload. Server-only: the nominal is bound to a real
# order server-side, so this must NOT ship to the browser (no VITE_ prefix).
QRIS_STATIC_PAYLOAD=
# Turn on tag-54 dynamic nominal ONLY after a small real test transaction is
# accepted by the acquirer. Otherwise the static QR + manual nominal is used.
QRIS_DYNAMIC_ENABLED=false

# ─── Ops ───
# Secret for the daily expire-orders cron (Vercel sends it as a Bearer token).
CRON_SECRET=
# Telegram admin notifications (new orders, approvals, device resets). Optional.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
